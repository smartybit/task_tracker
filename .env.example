# Development only. Copy to .env and replace values for local use.
# compose.test.yaml deliberately does not use these values.
DJANGO_SECRET_KEY=replace-with-a-random-development-secret
POSTGRES_PASSWORD=replace-with-a-development-database-password
# Shared IANA working zone for all users, e.g. Europe/Berlin. Recreate web after changes.
WORKING_TIME_ZONE=UTC
